<?xml version="1.0" encoding="utf-8"?>
<!-- Règles d'extraction (API 31+) : les données de santé sont exclues de la
     sauvegarde cloud, mais conservées lors d'un transfert direct d'appareil
     (migration chiffrée téléphone à téléphone). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="pileo.db" />
        <exclude domain="database" path="pileo.db-wal" />
        <exclude domain="database" path="pileo.db-shm" />
        <exclude domain="database" path="pileo.db-journal" />
        <exclude domain="sharedpref" path="pileo_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pileo.db" />
        <include domain="database" path="pileo.db-wal" />
        <include domain="database" path="pileo.db-shm" />
        <include domain="database" path="pileo.db-journal" />
        <include domain="sharedpref" path="pileo_settings.xml" />
    </device-transfer>
</data-extraction-rules>
